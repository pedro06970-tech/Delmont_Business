APP_NAME="Delmont Business"
APP_ENVIRONMENT="development"
FRONTEND_ORIGIN="http://localhost:3000"
SESSION_TTL_MINUTES="480"
LOGIN_MAX_ATTEMPTS="5"
LOGIN_WINDOW_MINUTES="15"
DATABASE_URL="postgresql+psycopg://delmont:delmont@localhost:5432/delmont"
POSTGRES_DB="delmont"
POSTGRES_USER="delmont"
POSTGRES_PASSWORD="delmont"
POSTGRES_PORT="5432"
BACKEND_PORT="8000"
FRONTEND_PORT="3000"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# WhatsMiau e worker. Use uma variável diferente por loja e informe apenas o nome
# dessa variável no painel administrativo. Nunca cadastre a chave no banco.
WHATSMIAU_BASE_URL="https://api.whatsmiau.dev/v2"
WHATSMIAU_HTTP_TIMEOUT_SECONDS="10"
WHATS_MIAU_STORE_EXAMPLE_KEY=""
WHATS_MIAU_STORE_EXAMPLE_WEBHOOK_SECRET=""
REMINDER_DISPATCH_ENABLED="true"
REMINDER_HOMOLOGATION_ONLY="false"
REMINDER_WORKER_POLL_SECONDS="2"
REMINDER_WORKER_BATCH_SIZE="10"
REMINDER_CLAIM_TTL_SECONDS="120"
REMINDER_MAX_ATTEMPTS="3"
REMINDER_RETRY_BASE_SECONDS="30"
REMINDER_INSTANCE_CONCURRENCY="1"
REMINDER_MIN_INTERVAL_SECONDS="2"

# Somente para o comando explícito de bootstrap; não use valores padrão.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
